{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clickstream/v1",
  "title": "Albert's Marketplace clickstream event, schema_version 1",
  "description": "Built from real messages of the topic (2026-11-03). Unknown fields are accepted (safe change); a missing required field or a changed type is rejected to the DLQ.",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "event_time", "emitted_at", "buyer_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id":       { "type": "string", "minLength": 1 },
    "event_type":     { "enum": ["product_viewed", "added_to_cart", "order_placed"] },
    "event_time":     { "type": "string", "format": "date-time" },
    "emitted_at":     { "type": "string", "format": "date-time" },
    "session_id":     { "type": ["string", "null"] },
    "buyer_id":       { "type": "string", "minLength": 1 },
    "p_id":           { "type": ["string", "null"] },
    "qty":            { "type": ["integer", "null"], "minimum": 0 },
    "price":          { "type": ["number", "null"], "minimum": 0 },
    "order_id":       { "type": ["integer", "null"] },
    "amount":         { "type": ["number", "null"], "minimum": 0 },
    "currency":       { "type": ["string", "null"] },
    "payment_method": { "type": ["string", "null"] },
    "items": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["p_id", "qty"],
        "properties": {
          "p_id":  { "type": "string", "minLength": 1 },
          "qty":   { "type": "integer", "minimum": 1 },
          "price": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if":   { "required": ["event_type"], "properties": { "event_type": { "const": "product_viewed" } } },
      "then": { "required": ["p_id"], "properties": { "p_id": { "type": "string" } } }
    },
    {
      "if":   { "required": ["event_type"], "properties": { "event_type": { "const": "added_to_cart" } } },
      "then": { "required": ["p_id", "qty"], "properties": { "p_id": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } } }
    },
    {
      "if":   { "required": ["event_type"], "properties": { "event_type": { "const": "order_placed" } } },
      "then": { "required": ["order_id", "items"], "properties": { "order_id": { "type": "integer" }, "items": { "type": "array", "minItems": 1 } } }
    }
  ],
  "additionalProperties": true
}
