      "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
      "condition": { "age": 90, "matchesPrefix": ["bronze/export/"], "matchesStorageClass": ["STANDARD"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 90, "matchesPrefix": ["bronze/_dlq/"] }
    }
  ]
}
